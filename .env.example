# PenguinMod service roots for the wycats fork (see src/lib/pm-config.js).
# Unset vars fall back to the upstream PenguinMod defaults baked into pm-config.js.

# Main backend API (projects, users, studios). Our self-hosted backend:
PM_API_ROOT=https://penguinmod-backend.vercel.app

# Forked + self-hostable services. Fill in once deployed (Stage 4):
# PM_EXTENSIONS_ROOT=https://<our-extensions-gallery>.vercel.app
# PM_DOCS_ROOT=https://<our-docs>.vercel.app

# Content/CDN services — no clean upstream repo yet; left on PenguinMod until a
# future self-host stage. Override here when ready:
# PM_LIBRARY_ROOT=https://library.penguinmod.com
# PM_ASSET_CDN_ROOT=https://asset-cdn.penguinmod.com
