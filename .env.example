# PatternYard service roots for the wycats fork (see src/lib/pm-config.js).
# SUCCESS CRITERION: full runtime independence from penguinmod.com. Every root
# defaults to patternyard.dev infrastructure in pm-config.js; unset vars use
# those patternyard defaults, NEVER an upstream penguinmod.com fallback.
# Override a value only to point at alternate patternyard infra (e.g. preview).

# Main backend API (projects, users, studios, warm-tier assets):
PM_API_ROOT=https://api.patternyard.dev

# Forked self-hosted services:
PM_EXTENSIONS_ROOT=https://extensions.patternyard.dev
PM_LIBRARY_ROOT=https://library.patternyard.dev
PM_DOCS_ROOT=https://docs.patternyard.dev

# Project asset CDN (warm-tier) — served by the backend:
PM_ASSET_CDN_ROOT=https://api.patternyard.dev

# First-party site + editor self-reference:
PM_HOME_ROOT=https://patternyard.dev
PM_STUDIO_ROOT=https://studio.patternyard.dev
