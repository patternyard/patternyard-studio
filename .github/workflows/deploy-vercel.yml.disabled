# wycats fork: build the editor exactly like upstream (Node 16 + pnpm6,
# shamefully-hoisted) and deploy the prebuilt static output to Vercel.
# The fragile webpack-4 build runs on a controlled Node 16 here, so it does
# not depend on Vercel's build-time Node version.
#
# Service roots come from the committed .env (loaded by dotenv in
# webpack.config.js); PM_API_ROOT there points at our backend. Override by
# editing .env, not here.
#
# The only secret you must add to this repo is VERCEL_TOKEN (Settings ->
# Secrets and variables -> Actions). VERCEL_ORG_ID / VERCEL_PROJECT_ID are
# non-sensitive identifiers, inlined below.
name: Deploy editor to Vercel

on:
  workflow_dispatch:
  push:
    branches: ["wycats-main"]

concurrency:
  group: "deploy-vercel"
  cancel-in-progress: true

env:
  VERCEL_ORG_ID: "team_1A5hxCsAnX5KFLm69oklRZWB"
  VERCEL_PROJECT_ID: "prj_ORYYVAiXDxbVbIOo1wMmyYJhWgLJ"

jobs:
  build-and-deploy:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Install Node.js 16
        uses: actions/setup-node@v4
        with:
          node-version: 16.x

      - name: Install dependencies (pnpm6, shamefully hoisted)
        run: npm i -g pnpm@v6 && pnpm i --shamefully-hoist --force

      - name: Build editor
        run: NODE_ENV="production" ./node_modules/.bin/webpack --bail

      - name: Assemble Vercel Build Output (static)
        run: |
          mkdir -p .vercel/output/static
          cp -r build/* .vercel/output/static/
          printf '{ "version": 3 }' > .vercel/output/config.json

      - name: Deploy prebuilt output to Vercel
        run: |
          npm i -g vercel@latest
          vercel deploy --prebuilt --prod --token "$VERCEL_TOKEN"
        env:
          VERCEL_TOKEN: ${{ secrets.VERCEL_TOKEN }}
