# wycats / PatternYard deployment config.
# SUCCESS CRITERION: full runtime independence from penguinmod.com — every
# service root points at our own patternyard.dev infrastructure, never upstream.
# These mirror the code defaults in src/lib/pm-config.js; they are listed
# explicitly so local builds are independent without relying on the defaults.
PM_API_ROOT=https://api.patternyard.dev
PM_EXTENSIONS_ROOT=https://extensions.patternyard.dev
PM_LIBRARY_ROOT=https://library.patternyard.dev
PM_ASSET_CDN_ROOT=https://api.patternyard.dev
PM_DOCS_ROOT=https://docs.patternyard.dev
PM_HOME_ROOT=https://patternyard.dev
PM_STUDIO_ROOT=https://studio.patternyard.dev
